<div id="admin-content">
      <div class="container">
          <div class="row">
              <div class="col-md-10">
                <h1 class="admin-heading"><i class="fa fa-users"></i> All Users</h1>
              </div>
              <div class="col-md-2">
                <a class="add-new" href="/admin/add-user">add user</a>
              </div>
              <div class="col-md-12">
                <div class="" id="usersTable">

                </div>
              
                
              </div>
          </div>
      </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/tabulator-tables@6.3.0/dist/js/tabulator.min.js"></script>

  <script>
    // ✅ Fixed: typo 'usres' → 'users', and JSON.parse to get proper array
    const tableData = <%- JSON.stringify(users) %>

    const table = new Tabulator("#usersTable", {
        data: tableData,
        layout: "fitColumns",
        pagination: "local",        // ✅ built-in pagination — remove your manual one
        paginationSize: 10,
        columns: [
            { title: "Full Name", field: "fullname",  headerFilter:"input" },
            { title: "Username",  field: "username",  headerFilter:"input" },
            { title: "Role",      field: "role",      headerFilter:"input" },
            {
                title: "Actions",
                formatter: function(cell) {
                    const id = cell.getRow().getData()._id;
                    return `
                        <a href="/admin/update-user/${id}" class="btn btn-sm btn-warning">Edit</a>
                       <button class="btn btn-sm btn-danger" onclick="deleteUser('${id}')">Delete</button>
                    `;
                }
            }
        ]
    });

   async function deleteUser(id) {                          // ✅ async function
        if (confirm("Are you sure you want to delete this user?")) {
            try {
                const response = await fetch(`/admin/delete-user/${id}`, {  // ✅ / not ?
                    method: 'DELETE'                         // ✅ uppercase DELETE
                });
                if (response.ok) {
                    window.location.reload();                // ✅ reload() is a function call
                } else if(response.status === 400) {
                    const data = await response.json();
                    alert(data.message);
                } else {
                    console.error('Failed to delete user');
                }
            } catch (err) {
                console.error(err);                          // ✅ log actual error
            }
        }
    }
</script>



<%- contentFor('tabulatorCSS')%>
