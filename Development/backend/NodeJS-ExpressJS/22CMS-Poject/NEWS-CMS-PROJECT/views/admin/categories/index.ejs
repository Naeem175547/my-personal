<div id="admin-content">
    <div class="container">
        <div class="row">
            <div class="col-md-10">
                <h1 class="admin-heading"><i class="fa fa-gears"></i> All Categories</h1>
            </div>
            <div class="col-md-2">
                <a class="add-new" href="/admin/add-category">add category</a>
            </div>
            <div class="col-md-12">
                <div class="" id="categoriesTable"></div>


            </div>
        </div>
    </div>
</div>

 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://unpkg.com/tabulator-tables@6.3.0/dist/js/tabulator.min.js"></script>

  <script>
    
    const tableData = <%- JSON.stringify(categories) %>
    const table = new Tabulator("#categoriesTable", {
        data: tableData,
        layout: "fitColumns",
        pagination: "local",        // ✅ built-in pagination — remove your manual one
        paginationSize: 10,
        columns: [
              { title: "Sr.No.",  formatter:"rownum", width:100 },
            { title: "category Name", field: "name",  headerFilter:"input" },
            { title: "Slug",  field: "slug",  headerFilter:"input" },
            
            {
                title: "Actions",
                formatter: function(cell) {
                    const id = cell.getRow().getData()._id;
                    return `
                        <a href="/admin/update-category/${id}" class="btn btn-sm btn-warning">Edit</a>
                       <button class="btn btn-sm btn-danger" onclick="deleteCategory('${id}')">Delete</button>
                    `;
                }
            }
        ]
    });

   async function deleteCategory(id) {                          
        if (confirm("Are you sure you want to delete this category?")) {
            try {
                const response = await fetch(`/admin/delete-category/${id}`, {  // ✅ / not ?
                    method: 'DELETE'                        
                });
                if (response.ok) {
                    window.location.reload();               
                } else {
                    alert(    'Failed to delete user');
                }
            } catch (err) {
                console.error(err);                          
            }
        }
    }
</script>



<%- contentFor('tabulatorCSS')%>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://unpkg.com/tabulator-tables@6.3.0/dist/css/tabulator.min.css" rel="stylesheet">

